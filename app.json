{
  "expo": {
    "name": "Innova Dashboard App",
    "slug": "pending-reports-mobile",
    "version": "3.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo-innova.png",
    "scheme": "pendingreportsmobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vinixius99.pendingreportsmobile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/logo-innova.png",
        "monochromeImage": "./assets/images/logo-innova.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.vinixius99.pendingreportsmobile",
      "googleServicesFile": "./android/app/google-services.json",
        "googleMapsApiKey": "AIzaSyC5w6JDrPKalwOGCYjatejmSHDyP63jQdc"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/logo-innova.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#C9A13B",
          "sounds": ["./assets/protocol-rington.wav"]
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "La app necesita acceso a tus fotos para adjuntar evidencias.",
          "cameraPermission": "La app necesita usar la camara para tomar la selfie de inicio de turno."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo-innova.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ce9c097d-1043-4e8f-b516-9b20761f9e54"
      }
    }
  }
}
